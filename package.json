{
  "name": "edgetunnel",
  "version": "2.1.0",
  "description": "Edge Tunnel - Cloudflare Workers/Pages tunnel solution",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "format": "prettier --write \"src/**/*.{js,ts,json}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\" \"*.js\"",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "check": "node --check src/worker.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "vless",
    "trojan",
    "shadowsocks",
    "proxy"
  ],
  "license": "GPL-3.0",
  "devDependencies": {
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "wrangler": "4"
  },
  "engines": {
    "node": ">=18"
  }
}
